# Copy this file to `.env` (same folder) and fill in real values.
# docker compose reads .env automatically — no more `export` lines, ever.
# NEVER commit .env to git; .env.example (this file) is the shareable template.

POSTGRES_PASSWORD=
MINIO_PASSWORD=
AGENT_RO_PASSWORD=
NVIDIA_API_KEY=
TAVILY_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # optional override
