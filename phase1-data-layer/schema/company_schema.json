        { "id": "existing_investor_rights", "label": "Existing Investor Rights", "type": "text", "sources": ["document", "founder"], "founder_only": true, "guidance": "Liquidation pref, anti-dilution, pro-rata, veto rights." }
      ]
    },
    {
      "code": "H",
      "id": "current_raise",
      "title": "Current Fundraising Requirement",
      "fields": [
