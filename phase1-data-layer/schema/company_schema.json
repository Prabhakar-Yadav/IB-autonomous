        { "id": "investor_type_sought", "label": "Investor Type Sought", "type": "text", "sources": ["transcript", "founder"], "founder_only": true, "guidance": "" },
        { "id": "term_sheets_lois_in_hand", "label": "Any Existing Term Sheets / LOIs in Hand", "type": "text", "sources": ["transcript", "founder"], "founder_only": true, "guidance": "" },
