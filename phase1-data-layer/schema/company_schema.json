        { "id": "instrument_sought", "label": "Instrument Sought", "type": "text", "sources": ["transcript", "founder"], "founder_only": true, "guidance": "Equity / convertible / SAFE / debt." },
        { "id": "target_valuation", "label": "Target Pre-money / Post-money Valuation", "type": "text", "sources": ["transcript", "founder"], "founder_only": true, "guidance": "" },
        { "id": "valuation_basis", "label": "Valuation Basis / Benchmark Cited", "type": "text", "sources": ["transcript", "founder"], "founder_only": true, "guidance": "" },
        { "id": "use_of_funds", "label": "Use of Funds", "type": "text", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "% breakdown — product, hiring, GTM, capex, working capital." },
