{
  "schema_version": "1.0.0",
  "name": "master_company_schema",
  "generated_from": "IB inputs required from nemoclaw.xlsx",
  "description": "Canonical per-company intake schema for the AI-native IB platform. Every field value stored against this schema must carry the metadata envelope (source, confidence, collected_by, version). The LLM is never the source of truth; unknown stays unknown.",
  "field_types": ["text", "date", "datetime", "url", "number", "percent", "money", "list", "boolean"],
  "source_types": {
    "web": "public internet (worker-collected or agent search)",
    "document": "pitch deck, data room, filing, report provided to the firm",
    "transcript": "founder/management call or meeting transcript",
    "founder": "stated directly by the company, not independently verifiable",
    "internal": "firm-internal process data (owners, next steps)"
  },
  "sections": [
    {
      "code": "A",
      "id": "interaction_logistics",
      "title": "Interaction Logistics",
      "fields": [
        { "id": "interaction_date_time", "label": "Date & Time", "type": "datetime", "sources": ["transcript", "internal"], "founder_only": false, "guidance": "When the interaction took place." },
        { "id": "interaction_mode", "label": "Mode of Interaction", "type": "text", "sources": ["transcript", "internal"], "founder_only": false, "guidance": "Call / video / in-person / email." },
        { "id": "interaction_duration", "label": "Duration", "type": "text", "sources": ["transcript", "internal"], "founder_only": false, "guidance": "Length of the interaction." }
      ]
    },
    {
      "code": "B",
      "id": "company_snapshot",
      "title": "Company Snapshot",
      "fields": [
        { "id": "legal_entity_name", "label": "Legal Entity Name", "type": "text", "sources": ["web", "document"], "founder_only": false, "guidance": "Registered legal name, not the brand." },
        { "id": "brand_trading_name", "label": "Brand / Trading Name", "type": "text", "sources": ["web", "document"], "founder_only": false, "guidance": "" },
        { "id": "date_of_incorporation", "label": "Date of Incorporation", "type": "date", "sources": ["web", "document"], "founder_only": false, "guidance": "" },
        { "id": "jurisdiction_of_incorporation", "label": "Jurisdiction of Incorporation", "type": "text", "sources": ["web", "document"], "founder_only": false, "guidance": "Country/state of registration." },
        { "id": "registered_operating_hq", "label": "Registered & Operating HQ", "type": "text", "sources": ["web", "document"], "founder_only": false, "guidance": "Both if they differ." },
        { "id": "website", "label": "Website", "type": "url", "sources": ["web"], "founder_only": false, "guidance": "" },
        { "id": "sector_subsector", "label": "Sector / Sub-sector", "type": "text", "sources": ["web", "document"], "founder_only": false, "guidance": "e.g. cybersecurity, AI infra, semiconductors, climate tech." },
        { "id": "company_stage", "label": "Company Stage", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "Pre-seed / seed / Series A-… / growth / pre-IPO." },
        { "id": "one_line_description", "label": "One-line Description (Elevator Pitch)", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "mission_problem", "label": "Mission / Problem Being Solved", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "" }
      ]
    },
    {
      "code": "C",
      "id": "business_product",
      "title": "Business & Product Overview",
      "fields": [
        { "id": "core_products_services", "label": "Core Product(s) / Service(s)", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "business_model", "label": "Business Model", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "SaaS, licensing, marketplace, hardware, usage-based, hybrid." },
        { "id": "target_customer_segments", "label": "Target Customer Segment(s)", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "SMB / mid-market / enterprise / govt / consumer." },
        { "id": "geographies_served_today", "label": "Geographies Served Today", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "geographies_targeted_next_12_24m", "label": "Geographies Targeted Next 12–24 Months", "type": "text", "sources": ["document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "product_roadmap_next_12m", "label": "Product Roadmap — Next 12 Months", "type": "text", "sources": ["document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "key_differentiators", "label": "Key Differentiators vs. Alternatives", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "business_model_pivots", "label": "Any Pivots in Business Model to Date", "type": "text", "sources": ["transcript", "founder"], "founder_only": false, "guidance": "" }
      ]
    },
    {
      "code": "D",
      "id": "technology_ip",
      "title": "Technology & Intellectual Property (Deep Tech Focus)",
      "section_guidance": "For deep tech companies (AI/ML, semiconductors, biotech, quantum, robotics, materials science) probe technical defensibility in depth.",
      "fields": [
        { "id": "core_technology_basis", "label": "Core Technology / Scientific Basis", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "technology_readiness_level", "label": "Technology Readiness Level (TRL)", "type": "text", "sources": ["document", "transcript"], "founder_only": false, "guidance": "Lab / prototype / pilot / commercial scale." },
        { "id": "patents", "label": "Patents Filed / Granted", "type": "text", "sources": ["web", "document"], "founder_only": false, "guidance": "Jurisdictions, application numbers, status." },
        { "id": "trade_secrets_datasets", "label": "Trade Secrets / Proprietary Datasets", "type": "text", "sources": ["transcript", "founder"], "founder_only": true, "guidance": "" },
        { "id": "open_source_dependencies", "label": "Open-source Dependencies / Licensing Exposure", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "third_party_licensed_tech", "label": "Third-party / Licensed-in Technology", "type": "text", "sources": ["document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "rd_team_size_structure", "label": "R&D Team Size & Structure", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "key_technical_risks", "label": "Key Technical Risks / Unresolved Challenges", "type": "text", "sources": ["document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "regulatory_approvals_needed", "label": "Regulatory Approvals Needed", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "e.g. FDA, CE, telecom, spectrum." },
        { "id": "manufacturing_supply_chain", "label": "Manufacturing / Supply Chain Dependencies", "type": "text", "sources": ["document", "transcript"], "founder_only": false, "guidance": "If hardware." }
      ]
    },
    {
      "code": "E",
      "id": "market_competition",
      "title": "Market & Competitive Landscape",
      "fields": [
        { "id": "tam_sam_som", "label": "TAM / SAM / SOM", "type": "text", "sources": ["document", "transcript"], "founder_only": false, "guidance": "Company's own estimates; label them as such." },
        { "id": "market_sizing_basis", "label": "Source / Basis for Market Sizing", "type": "text", "sources": ["document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "direct_competitors", "label": "Key Direct Competitors", "type": "text", "sources": ["web", "document"], "founder_only": false, "guidance": "" },
        { "id": "indirect_competitors_substitutes", "label": "Key Indirect Competitors / Substitutes", "type": "text", "sources": ["web", "document"], "founder_only": false, "guidance": "" },
        { "id": "competitive_moat", "label": "Competitive Positioning / Moat", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "" },
        { "id": "market_tailwinds_headwinds", "label": "Market Tailwinds / Headwinds", "type": "text", "sources": ["web", "document"], "founder_only": false, "guidance": "" },
        { "id": "barriers_to_entry", "label": "Barriers to Entry for New Competitors", "type": "text", "sources": ["web", "document", "transcript"], "founder_only": false, "guidance": "" }
      ]
    },
    {
      "code": "F",
      "id": "financials",
      "title": "Financial Overview",
      "section_guidance": "Request last 3 years actuals + current year forecast, ideally via data room; capture headline figures here. NEVER estimated or web-guessed — document/transcript/founder sources only.",
      "fields": [
        { "id": "revenue_last_3fy", "label": "Revenue — Last 3 FY (actuals)", "type": "text", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "Per-year figures with currency." },
        { "id": "revenue_current_fy_forecast", "label": "Revenue — Current Year Forecast", "type": "money", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "" },
        { "id": "arr_mrr", "label": "ARR / MRR (if SaaS)", "type": "text", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "Include the definition used by the company." },
        { "id": "revenue_growth_yoy", "label": "Revenue Growth Rate (YoY)", "type": "percent", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "" },
        { "id": "gross_margin", "label": "Gross Margin", "type": "percent", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "" },
        { "id": "ebitda_operating_margin", "label": "EBITDA / Operating Margin", "type": "percent", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "" },
        { "id": "net_burn_monthly", "label": "Net Burn (Monthly)", "type": "money", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "" },
        { "id": "cash_balance_runway", "label": "Cash Balance & Runway", "type": "text", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "As of latest month-end." },
        { "id": "key_cost_line_items", "label": "Key Cost Line Items", "type": "text", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "Payroll, cloud/infra, S&M, R&D." },
        { "id": "audited_financials", "label": "Audited Financials Available?", "type": "text", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "Auditor name, last audit date." },
        { "id": "accounting_standard", "label": "Accounting Standard Used", "type": "text", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "Ind AS / IFRS / US GAAP." },
        { "id": "outstanding_debt_convertibles", "label": "Outstanding Debt / Convertible Instruments", "type": "text", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "" },
        { "id": "related_party_transactions", "label": "Related-party Transactions", "type": "text", "sources": ["document", "transcript", "founder"], "founder_only": true, "guidance": "" }
      ]
    },
    {
      "code": "G",
      "id": "cap_table_fundraising_history",
      "title": "Cap Table & Fundraising History",
      "fields": [
        { "id": "cap_table_summary", "label": "Current Cap Table Summary", "type": "text", "sources": ["document", "founder"], "founder_only": true, "guidance": "Founders / ESOP pool / investors, % holding." },
        { "id": "total_equity_raised", "label": "Total Equity Raised to Date", "type": "money", "sources": ["web", "document", "founder"], "founder_only": false, "guidance": "Often public via funding announcements." },
        { "id": "prior_funding_rounds", "label": "Prior Funding Rounds", "type": "text", "sources": ["web", "document", "founder"], "founder_only": false, "guidance": "Round, date, amount, lead investor, valuation." },
        { "id": "current_investors_board", "label": "Current Investors on Board", "type": "text", "sources": ["web", "document", "founder"], "founder_only": false, "guidance": "Name, board seat / observer rights." },
