# Copy the variables you need into a local .env file.
# Keep real credentials out of GitHub.

# Core Docker Compose services
POSTGRES_PASSWORD=
MINIO_PASSWORD=
AGENT_RO_PASSWORD=

# NVIDIA / OpenAI-compatible endpoint configuration
NVIDIA_API_KEY=
NVIDIA_API_KEY1=
NVIDIA_API_KEY2=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Optional collection/extraction integrations
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
SEARXNG_URL=http://searxng:8080

# Scheduler
INTERVAL_HOURS=24

# On-prem RAG extension
ZT_PG_PASSWORD=
OLLAMA_URL=http://host.docker.internal:11434
